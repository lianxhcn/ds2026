   "source": [
    "# 配图生成脚本\n",
    "\n",
    "运行此 notebook 将在 `figures/` 目录下生成 `blog.md` 中引用的所有配图。\n",
    "\n",
    "**依赖**：`numpy`, `matplotlib`\n",
    "\n",
    "```bash\n",
    "pip install numpy matplotlib\n",
    "```"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "import matplotlib.patches as mpatches\n",
    "from matplotlib.patches import FancyArrowPatch\n",
    "import os\n",
    "\n",
    "os.makedirs('figures', exist_ok=True)\n",
    "\n",
    "# ── 全局风格 ──────────────────────────────────────────────\n",
    "plt.rcParams.update({\n",
    "    'font.family': ['DejaVu Sans', 'Arial'],\n",
    "    'axes.spines.top': False,\n",
    "    'axes.spines.right': False,\n",
    "    'figure.dpi': 150,\n",
    "    'savefig.bbox': 'tight',\n",
    "    'savefig.transparent': False,\n",
    "})\n",
    "\n",
    "COLORS = {\n",
    "    'L1':   '#E74C3C',   # red\n",
    "    'L2':   '#2980B9',   # blue\n",
    "    'Linf': '#27AE60',   # green\n",
    "    'lasso': '#E74C3C',\n",
    "    'ridge': '#2980B9',\n",
    "    'contour': '#95A5A6',\n",
    "    'bg': '#FAFAFA',\n",
    "}\n",
    "print('环境就绪，开始绘图 ✓')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 图1：三种范数的单位球（二维截面）\n",
    "\n",
    "展示 $\\|\\mathbf{x}\\|_p = 1$ 时，$L^1$、$L^2$、$L^\\infty$ 范数的"单位球"形状。"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "fig, axes = plt.subplots(1, 3, figsize=(13, 4.5))\n",
    "fig.patch.set_facecolor(COLORS['bg'])\n",
    "\n",
    "configs = [\n",
    "    ('$L^1$ 范数  ($p=1$)', r'$\\|\\mathbf{x}\\|_1 = 1$', '菱形',  COLORS['L1']),\n",
    "    ('$L^2$ 范数  ($p=2$)', r'$\\|\\mathbf{x}\\|_2 = 1$', '圆形',  COLORS['L2']),\n",
    "    ('$L^\\\\infty$ 范数  ($p\\\\to\\\\infty$)', r'$\\|\\mathbf{x}\\|_\\infty = 1$', '正方形', COLORS['Linf']),\n",
    "]\n",
    "\n",
    "t = np.linspace(0, 2 * np.pi, 1000)\n",
    "\n",
    "def lp_unit_circle(p, n=2000):\n",
    "    \"\"\"Parametric points on the L^p unit ball boundary in 2D.\"\"\"\n",
    "    angles = np.linspace(0, 2 * np.pi, n)\n",
    "    xs, ys = [], []\n",
    "    for a in angles:\n",
    "        # direction vector\n",
    "        cx, cy = np.cos(a), np.sin(a)\n",
    "        # scale so Lp norm = 1\n",
    "        norm = (abs(cx)**p + abs(cy)**p)**(1/p)\n",
    "        xs.append(cx / norm)\n",
    "        ys.append(cy / norm)\n",
    "    return np.array(xs), np.array(ys)\n",
    "\n",
    "for ax, (title, subtitle, shape_name, color), p in zip(axes, configs, [1, 2, 1e6]):\n",
    "    ax.set_facecolor(COLORS['bg'])\n",
    "    xc, yc = lp_unit_circle(p)\n",
    "    ax.fill(xc, yc, alpha=0.18, color=color)\n",
    "    ax.plot(xc, yc, color=color, linewidth=2.5, label=shape_name)\n",
    "\n",
    "    # axes arrows\n",
    "    for dx, dy in [(1.5,0),(-1.5,0),(0,1.5),(0,-1.5)]:\n",
    "        ax.annotate('', xy=(dx*0.92, dy*0.92), xytext=(0,0),\n",
    "                    arrowprops=dict(arrowstyle='->', color='#666', lw=1.2))\n",
    "    ax.axhline(0, color='#AAA', lw=0.8, zorder=0)\n",
    "    ax.axvline(0, color='#AAA', lw=0.8, zorder=0)\n",
    "\n",
    "    # key points annotation\n",
    "    key_pts = [(1,0),(0,1),(-1,0),(0,-1)]\n",
    "    for kx, ky in key_pts:\n",
    "        ax.scatter(kx, ky, color=color, s=40, zorder=5)\n",
    "\n",
    "    ax.set_xlim(-1.6, 1.6); ax.set_ylim(-1.6, 1.6)\n",
    "    ax.set_aspect('equal')\n",
    "    ax.set_title(title, fontsize=13, fontweight='bold', pad=10)\n",
    "    ax.text(0, -1.52, subtitle, ha='center', va='top', fontsize=10, color='#444')\n",
    "    ax.text(1.35, -0.12, '$x_1$', fontsize=10, color='#555')\n",
    "    ax.text(0.06, 1.35, '$x_2$', fontsize=10, color='#555')\n",
    "\n",
    "    # shape label inside\n",
    "    ax.text(0, 0.55, shape_name, ha='center', va='center',\n",
    "            fontsize=12, color=color, fontweight='bold', alpha=0.85)\n",
    "\n",
    "    ax.tick_params(left=False, bottom=False, labelleft=False, labelbottom=False)\n",
    "    for spine in ax.spines.values():\n",
    "        spine.set_visible(False)\n",
    "\n",
    "fig.suptitle('三种 $L^p$ 范数的"单位球"（二维截面）',\n",
    "             fontsize=15, fontweight='bold', y=1.02)\n",
    "fig.text(0.5, -0.04,\n",
    "         '距离公式：$d_p(\\\\mathbf{x}, \\\\mathbf{y}) = \\\\|\\\\mathbf{x}-\\\\mathbf{y}\\\\|_p$   '\n",
    "         '（$L^1$=曼哈顿，$L^2$=欧氏，$L^\\\\infty$=切比雪夫）',\n",
    "         ha='center', fontsize=10, color='#555')\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.savefig('figures/norm_unit_balls.png', dpi=150)\n",
    "plt.show()\n",
    "print('✓ 保存至 figures/norm_unit_balls.png')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 图2：Lasso vs Ridge 几何解释\n",
    "\n",
    "经典的约束域与等高线相切图，解释为什么 Lasso 产生稀疏解。"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "fig, axes = plt.subplots(1, 2, figsize=(12, 5.5))\n",
    "fig.patch.set_facecolor(COLORS['bg'])\n",
    "\n",
    "# ── 损失函数等高线（椭圆，最优解在右上方）──\n",
    "w1_opt, w2_opt = 1.8, 1.4   # unconstrained optimum\n",
    "\n",
    "def loss_value(w1, w2, scale=1.0):\n",
    "    \"\"\"Elliptical loss centered at (w1_opt, w2_opt).\"\"\"\n",
    "    return ((w1 - w1_opt)**2 / 1.0 + (w2 - w2_opt)**2 / 0.6) / scale\n",
    "\n",
    "W1, W2 = np.meshgrid(np.linspace(-2.5, 2.8, 400), np.linspace(-2.5, 2.8, 400))\n",
    "Z = loss_value(W1, W2)\n",
    "\n",
    "for ax, method, p, color, constraint_r, tangent_pt, label in zip(\n",
    "    axes,\n",
    "    ['Lasso（$L^1$ 正则化）', 'Ridge（$L^2$ 正则化）'],\n",
    "    [1, 2],\n",
    "    [COLORS['lasso'], COLORS['ridge']],\n",
    "    [1.0, 1.15],\n",
    "    [(0.0, 1.0), (0.72, 0.88)],   # approximate tangent points\n",
    "    ['切点在顶点（坐标轴上）\\n→ $w_1^* = 0$，产生稀疏解',\n",
    "     '切点不在坐标轴上\\n→ 系数压缩但不归零']\n",
    "):\n",
    "    ax.set_facecolor(COLORS['bg'])\n",
    "\n",
    "    # contour lines\n",
    "    levels = [0.4, 0.9, 1.6, 2.6, 4.0]\n",
    "    cs = ax.contour(W1, W2, Z, levels=levels, colors=COLORS['contour'],\n",
    "                    linewidths=1.2, alpha=0.7)\n",
    "\n",
    "    # constraint region\n",
    "    t_vals = np.linspace(0, 2 * np.pi, 1000)\n",
    "    if p == 1:\n",
    "        cx = constraint_r * np.sign(np.cos(t_vals)) * np.abs(np.cos(t_vals))\n",
    "        cy = constraint_r * np.sign(np.sin(t_vals)) * np.abs(np.sin(t_vals))\n",
    "        # correct diamond shape\n",
    "        cx2, cy2 = lp_unit_circle(1)\n",
    "        cx2 *= constraint_r; cy2 *= constraint_r\n",
    "        ax.fill(cx2, cy2, alpha=0.25, color=color, zorder=2)\n",
    "        ax.plot(cx2, cy2, color=color, linewidth=2.5, zorder=3,\n",
    "                label=f'$\\\\|\\\\mathbf{{w}}\\\\|_1 \\\\leq {constraint_r}$')\n",
    "    else:\n",
    "        circle = plt.Circle((0, 0), constraint_r, color=color,\n",
    "                             fill=True, alpha=0.25, zorder=2)\n",
    "        ax.add_patch(circle)\n",
    "        circle_border = plt.Circle((0, 0), constraint_r, color=color,\n",
    "                                   fill=False, linewidth=2.5, zorder=3)\n",
    "        ax.add_patch(circle_border)\n",
    "\n",
    "    # unconstrained optimum\n",
    "    ax.scatter(w1_opt, w2_opt, marker='*', s=200, color='#F39C12',\n",
    "               zorder=6, label='无约束最优解')\n",
    "    ax.annotate('无约束\\n最优解', xy=(w1_opt, w2_opt),\n",
    "                xytext=(w1_opt+0.25, w2_opt+0.35),\n",
    "                fontsize=8.5, color='#E67E22',\n",
    "                arrowprops=dict(arrowstyle='->', color='#E67E22', lw=1.0))\n",
    "\n",
    "    # tangent point\n",
    "    tx, ty = tangent_pt\n",
    "    ax.scatter(tx, ty, marker='o', s=120, color=color,\n",
    "               zorder=7, edgecolors='white', linewidths=1.5)\n",
    "    offset = (-0.6, 0.25) if p == 1 else (0.15, 0.4)\n",
    "    ax.annotate('切点（约束最优解）', xy=(tx, ty),\n",
    "                xytext=(tx + offset[0], ty + offset[1]),\n",
    "                fontsize=8.5, color=color,\n",
    "                arrowprops=dict(arrowstyle='->', color=color, lw=1.0))\n",
    "\n",
    "    # axes\n",
    "    ax.axhline(0, color='#888', lw=0.9, zorder=1)\n",
    "    ax.axvline(0, color='#888', lw=0.9, zorder=1)\n",
    "    ax.set_xlim(-2.2, 2.6); ax.set_ylim(-2.0, 2.6)\n",
    "    ax.set_xlabel('$w_1$', fontsize=12)\n",
    "    ax.set_ylabel('$w_2$', fontsize=12)\n",
    "    ax.set_title(method, fontsize=13, fontweight='bold')\n",
    "\n",
    "    # annotation box\n",
    "    ax.text(0.03, 0.04, label, transform=ax.transAxes,\n",
    "            fontsize=9, color=color, va='bottom',\n",
    "            bbox=dict(boxstyle='round,pad=0.4', facecolor='white',\n",
    "                      edgecolor=color, alpha=0.85))\n",
    "\n",
    "    for spine in ['top','right']:\n",
    "        ax.spines[spine].set_visible(False)\n",
    "\n",
    "fig.suptitle('为什么 Lasso 产生稀疏解？——约束域与等高线的几何关系',\n",
    "             fontsize=14, fontweight='bold', y=1.02)\n",
    "fig.text(0.5, -0.03,\n",
    "         '等高线 = 损失函数等值面；优化目标 = 找最小等高线与约束域的切点',\n",
    "         ha='center', fontsize=10, color='#555')\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.savefig('figures/lasso_ridge_geometry.png', dpi=150)\n",
    "plt.show()\n",
    "print('✓ 保存至 figures/lasso_ridge_geometry.png')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 图3（附加）：不同距离的等距线对比\n",
    "\n",
    "从同一中心点出发，展示三种距离下"距离相等"的点的轨迹——即范数单位球的直观对比。"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "fig, ax = plt.subplots(figsize=(6.5, 6))\n",
    "fig.patch.set_facecolor(COLORS['bg'])\n",
    "ax.set_facecolor(COLORS['bg'])\n",
    "\n",
    "norm_configs = [\n",
    "    (1,   COLORS['L1'],   '$L^1$（曼哈顿）', '--'),\n",
    "    (2,   COLORS['L2'],   '$L^2$（欧氏）',   '-'),\n",
    "    (1e6, COLORS['Linf'], '$L^\\\\infty$（切比雪夫）', ':'),\n",
    "]\n",
    "\n",
    "for p, color, label, ls in norm_configs:\n",
    "    xc, yc = lp_unit_circle(p)\n",
    "    ax.plot(xc, yc, color=color, linewidth=2.8, linestyle=ls, label=label)\n",
    "\n",
    "# center point\n",
    "ax.scatter(0, 0, color='#333', s=60, zorder=5)\n",
    "ax.text(0.05, 0.05, '原点', fontsize=10, color='#333')\n",
    "\n",
    "# annotation: same distance, different shape\n",
    "ax.annotate('', xy=(0.71, 0.71), xytext=(0,0),\n",
    "            arrowprops=dict(arrowstyle='->', color=COLORS['L2'], lw=1.5, linestyle='-'))\n",
    "ax.text(0.38, 0.42, '$r=1$', fontsize=10, color=COLORS['L2'], rotation=45)\n",
    "\n",
    "ax.axhline(0, color='#AAA', lw=0.8)\n",
    "ax.axvline(0, color='#AAA', lw=0.8)\n",
    "ax.set_xlim(-1.55, 1.55)\n",
    "ax.set_ylim(-1.55, 1.55)\n",
    "ax.set_aspect('equal')\n",
    "ax.set_xlabel('$x_1$', fontsize=12)\n",
    "ax.set_ylabel('$x_2$', fontsize=12)\n",
    "ax.set_title('三种距离的等距线对比\\n（到原点距离 = 1 的所有点）',\n",
    "             fontsize=13, fontweight='bold')\n",
    "ax.legend(fontsize=11, loc='upper right', framealpha=0.9)\n",
    "\n",
    "# key insight\n",
    "ax.text(-1.5, -1.45,\n",
    "        '同样两点，不同距离 → 不同度量结果',\n",
    "        fontsize=9, color='#555',\n",
    "        bbox=dict(boxstyle='round', facecolor='white', edgecolor='#CCC', alpha=0.9))\n",
    "\n",
    "for spine in ['top','right']:\n",
    "    ax.spines[spine].set_visible(False)\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.savefig('figures/distance_comparison.png', dpi=150)\n",
    "plt.show()\n",
    "print('✓ 保存至 figures/distance_comparison.png')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 图4（附加）：L1 vs L2 损失对异常值的响应\n",
    "\n",
    "展示残差从 0 增大时，$L^1$ 和 $L^2$ 损失的增长方式不同，从而说明 MAE 对异常值更鲁棒。"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "fig, axes = plt.subplots(1, 2, figsize=(12, 4.5))\n",
    "fig.patch.set_facecolor(COLORS['bg'])\n",
    "\n",
    "r = np.linspace(-4, 4, 400)\n",
    "\n",
    "# ── 左图：损失函数曲线 ──\n",
    "ax = axes[0]\n",
    "ax.set_facecolor(COLORS['bg'])\n",
    "ax.plot(r, r**2,    color=COLORS['L2'], lw=2.5, label='$L^2$ 损失：$r^2$（MSE）')\n",
    "ax.plot(r, np.abs(r), color=COLORS['L1'], lw=2.5, linestyle='--',\n",
    "        label='$L^1$ 损失：$|r|$（MAE）')\n",
    "ax.axvline(3, color='#999', lw=1, linestyle=':')\n",
    "ax.text(3.05, 14.5, '异常残差\\n$r=3$', fontsize=9, color='#666')\n",
    "\n",
    "# annotations for outlier\n",
    "ax.scatter([3], [9],  color=COLORS['L2'], s=80, zorder=5)\n",
    "ax.scatter([3], [3],  color=COLORS['L1'], s=80, zorder=5)\n",
    "ax.annotate('$L^2$: 损失 = 9', xy=(3, 9),  xytext=(1.8, 11.5),\n",
    "            fontsize=9, color=COLORS['L2'],\n",
    "            arrowprops=dict(arrowstyle='->', color=COLORS['L2'], lw=1))\n",
    "ax.annotate('$L^1$: 损失 = 3', xy=(3, 3),  xytext=(0.5, 5.5),\n",
    "            fontsize=9, color=COLORS['L1'],\n",
    "            arrowprops=dict(arrowstyle='->', color=COLORS['L1'], lw=1))\n",
    "\n",
    "ax.set_xlabel('残差 $r = y - \\\\hat{y}$', fontsize=11)\n",
    "ax.set_ylabel('损失值', fontsize=11)\n",
    "ax.set_title('损失函数对残差的响应', fontsize=12, fontweight='bold')\n",
    "ax.legend(fontsize=10)\n",
    "ax.set_ylim(-0.5, 17)\n",
    "for spine in ['top','right']: ax.spines[spine].set_visible(False)\n",
    "\n",
    "# ── 右图：梯度（对残差的导数）──\n",
    "ax2 = axes[1]\n",
    "ax2.set_facecolor(COLORS['bg'])\n",
    "ax2.plot(r, 2*r,              color=COLORS['L2'], lw=2.5, label='$L^2$ 梯度：$2r$（线性增长）')\n",
    "ax2.plot(r, np.sign(r),       color=COLORS['L1'], lw=2.5, linestyle='--',\n",
    "         label='$L^1$ 梯度：$\\\\text{sign}(r)$（恒为 ±1）')\n",
    "\n",
    "ax2.axhline(0, color='#AAA', lw=0.8)\n",
    "ax2.set_xlabel('残差 $r$', fontsize=11)\n",
    "ax2.set_ylabel('损失梯度', fontsize=11)\n",
    "ax2.set_title('对异常值（大残差）的梯度响应', fontsize=12, fontweight='bold')\n",
    "ax2.legend(fontsize=10)\n",
    "\n",
    "# key insight\n",
    "ax2.text(0.03, 0.85,\n",
    "         '$L^2$：大残差 → 大梯度 → 被异常值主导\\n'\n",
    "         '$L^1$：梯度恒为 ±1 → 对异常值鲁棒',\n",
    "         transform=ax2.transAxes, fontsize=9, va='top',\n",
    "         bbox=dict(boxstyle='round,pad=0.4', facecolor='white',\n",
    "                   edgecolor='#CCC', alpha=0.9))\n",
    "for spine in ['top','right']: ax2.spines[spine].set_visible(False)\n",
    "\n",
    "fig.suptitle('MAE（$L^1$）vs MSE（$L^2$）：鲁棒性差异的来源',\n",
    "             fontsize=14, fontweight='bold', y=1.02)\n",
    "plt.tight_layout()\n",
    "plt.savefig('figures/l1_vs_l2_loss.png', dpi=150)\n",
    "plt.show()\n",
    "print('✓ 保存至 figures/l1_vs_l2_loss.png')"
   ]
  },
